{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "isDemo": {
      "type": "boolean"
    },
    "priors": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mean": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          },
          "required": [
            "mean",
            "weight",
            "provenance"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "venues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/venue"
      }
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "region",
    "isDemo",
    "venues"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caffeye offline snapshot v1",
  "$comment": "The runtime additionally rejects duplicate app IDs and (0,0) coordinates; validates finite numbers; and limits size to 20 MB. Source rights are not inferred from the schema.",
  "$defs": {
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ]
    },
    "venue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "Coffee",
            "Roasters",
            "Bakery+Cafe",
            "Tea/Boba",
            "Dessert Cafe",
            "Specialty"
          ]
        },
        "coordinate": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "latitude",
            "longitude"
          ]
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "model": {
          "enum": [
            "independent",
            "franchise"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "providerIDs": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "rating": {
          "anyOf": [
            {
              "$ref": "#/$defs/rating"
            },
            {
              "type": "null"
            }
          ]
        },
        "work": {
          "anyOf": [
            {
              "$ref": "#/$defs/work"
            },
            {
              "type": "null"
            }
          ]
        },
        "late": {
          "anyOf": [
            {
              "$ref": "#/$defs/late"
            },
            {
              "type": "null"
            }
          ]
        },
        "loved": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "curated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "county": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "neighborhood": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hours": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "website": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "googleURL": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "yelpURL": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "types": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "coordinate",
        "address",
        "city",
        "model",
        "provenance"
      ]
    },
    "rating": {
      "type": "object",
      "properties": {
        "average": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "average",
        "count",
        "provenance"
      ]
    },
    "work": {
      "type": "object",
      "properties": {
        "tier": {
          "enum": [
            "excellent",
            "good",
            "limited"
          ]
        },
        "note": {
          "type": "string"
        },
        "hasMeetingRoom": {
          "type": "boolean"
        },
        "meetingRoomNote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/provenance"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tier",
        "note",
        "hasMeetingRoom"
      ]
    },
    "late": {
      "type": "object",
      "properties": {
        "tier": {
          "enum": [
            "10pm+",
            "midnight"
          ]
        },
        "when": {
          "type": "string"
        }
      },
      "required": [
        "tier",
        "when"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "venues": {
            "contains": {
              "required": [
                "rating"
              ],
              "properties": {
                "rating": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "priors"
        ],
        "properties": {
          "priors": {
            "type": "object"
          }
        }
      }
    }
  ]
}
